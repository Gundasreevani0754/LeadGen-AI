# LeadGen AI — local environment
# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# ---------------------------------------------------------------------------
# Supabase — https://supabase.com  →  Settings
# ---------------------------------------------------------------------------
# Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings → API → Project API keys → service_role
# SERVER ONLY. Bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Settings → Database → Connection string → Transaction pooler (port 6543)
# Contains your DB password. Used by Drizzle for migrations and queries.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Lead sources
# ---------------------------------------------------------------------------
# https://serpapi.com → Dashboard → Your API Key   (free: 100 searches/month)
SERPAPI_KEY=

# https://apify.com → Settings → Integrations → API token   (free: $5 credits/month)
APIFY_TOKEN=

# ---------------------------------------------------------------------------
# Gemini — bulk extraction and classification
# https://aistudio.google.com/app/apikey   (free tier, no card)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Claude briefing worker (Phase 6)
# Runs locally via `claude -p` on your subscription — no API key needed.
# ---------------------------------------------------------------------------
CLAUDE_MODEL=opus
CLAUDE_EFFORT=medium
# Max briefs generated per day. Guards your plan quota.
CLAUDE_DAILY_BRIEF_CAP=15

# ---------------------------------------------------------------------------
# Pipeline tuning
# ---------------------------------------------------------------------------
# Minimum score (0-100) a lead needs before it reaches your board.
SCORE_THRESHOLD=65
# Max share of a batch allowed to be service providers (agencies, freelancers).
SERVICE_PROVIDER_MAX_RATIO=0.30
# Days before enrichment data is considered stale and worth re-crawling.
ENRICHMENT_TTL_DAYS=90
