{
  "name": "leadgen-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "verify": "node --env-file=.env.local scripts/verify-setup.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "enrich": "tsx --conditions=react-server --env-file=.env.local scripts/enrich.ts",
    "score": "tsx --conditions=react-server --env-file=.env.local scripts/score.ts",
    "brief": "tsx --conditions=react-server --env-file=.env.local scripts/brief.ts",
    "feedback": "tsx --conditions=react-server --env-file=.env.local scripts/feedback.ts",
    "migrate:legacy": "tsx --conditions=react-server --env-file=.env.local scripts/migrate-legacy.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "libphonenumber-js": "^1.13.13",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tldts": "^7.4.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.1",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
